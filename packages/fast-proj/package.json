{
  "name": "fast-proj",
  "version": "0.5.2",
  "description": "Fast batch coordinate conversions (UTM, transverse Mercator, Web Mercator, GCJ-02, BD-09) with typed-array APIs and an optional WebAssembly backend",
  "keywords": [
    "baidu",
    "bd09",
    "coordinates",
    "gcj02",
    "geodesy",
    "mars coordinates",
    "proj4",
    "projection",
    "transverse mercator",
    "utm",
    "wasm",
    "web mercator",
    "wgs84"
  ],
  "homepage": "https://github.com/cdcxd/fast-proj#readme",
  "bugs": "https://github.com/cdcxd/fast-proj/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdcxd/fast-proj.git",
    "directory": "packages/fast-proj"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geojson": {
      "types": "./dist/geojson.d.ts",
      "default": "./dist/geojson.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm.js"
    },
    "./fast-proj.wasm": "./dist/fast-proj.wasm",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/inline.ts --check && rm -rf dist && tsc -p tsconfig.build.json && bash wasm/build.sh",
    "inline": "bun scripts/inline.ts",
    "prepack": "bun run build",
    "test": "vitest run",
    "bench": "bun run build && node bench/run.mts && bun bench/run.mts && node bench/run.mts --browser"
  },
  "engines": {
    "node": ">=20"
  }
}
